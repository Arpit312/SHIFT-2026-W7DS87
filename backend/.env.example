# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True

# Photo Check AI.
# GEMINI_API_KEY is shared with the ChargeSathi chatbot.
# Do not expose these values in frontend env files.
PHOTO_CHECK_BACKEND=mock

# Ordered comma-separated list of Gemini model names to try (first valid wins).
# TODO(team): confirm the model names available to your account.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
GEMINI_API_KEY=

# Legacy single-model setting (used if GEMINI_MODELS is absent).
GEMINI_MODEL=

# Per-call timeout in seconds for a complete Gemini screening call (all models + retries).
GEMINI_TIMEOUT_SECONDS=30

# Maximum JSON-parse retries per model before moving to the next model.
GEMINI_MAX_RETRIES_PER_MODEL=2

# ChargeSathi chatbot (server-side only; never expose these to the browser)
CHATBOT_MODEL=gemini-2.0-flash
CHATBOT_TIMEOUT_SECONDS=25
CHATBOT_RATE_LIMIT_PER_MINUTE=20
CHATBOT_MAX_OUTPUT_TOKENS=1024
CHATBOT_MAX_MESSAGE_CHARS=2000
CHATBOT_MAX_HISTORY_TURNS=12
CHATBOT_THINKING_BUDGET=0
