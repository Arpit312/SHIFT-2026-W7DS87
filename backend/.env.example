# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True

# Photo Check AI (existing). Do not point CHATBOT_MODEL at this value.
PHOTO_CHECK_BACKEND=mock
GEMINI_API_KEY=
GEMINI_MODEL=

# ChargeSathi chatbot (server-side only; never expose these to the browser)
CHATBOT_MODEL=gemini-3.8-flash
CHATBOT_TIMEOUT_SECONDS=25
CHATBOT_RATE_LIMIT_PER_MINUTE=20
CHATBOT_MAX_OUTPUT_TOKENS=1024
CHATBOT_MAX_MESSAGE_CHARS=2000
CHATBOT_MAX_HISTORY_TURNS=12
CHATBOT_THINKING_BUDGET=0
